"""
Machine-local override for the patch-distribution root that lib/patch_out.py,
build_patch_m.py, and patch_gt_tables.py auto-deploy their MPQs into (see
apps/patch-service/README.md for what this directory is).

Copy this file to local_config.py (gitignored - this repo is published on
GitHub and the path below is specific to one operator's box, not something
to bake into tracked source) and edit DEPLOY_ROOT for your own machine. If
local_config.py doesn't exist, the three scripts above just skip
auto-deploy; each still writes its normal local var/dbc-patch/ output
either way, and build_patch_m.py/patch_gt_tables.py also take a --deploy-root
/--deploy flag to override this at the command line instead.
"""

from pathlib import Path

DEPLOY_ROOT = Path("/path/to/your/patch-root")

# Optional: the world DB client command generate.py's drop guard reads live ids with (read-only SELECTs, the query goes
# in on stdin; `$DBC_TOOLS_MYSQL` wins over this). Without it the guard checks the deployed patch-Z only.
# LIVE_DB_MYSQL = "docker exec -i <ac-database container> mysql -uroot -p<password>"
